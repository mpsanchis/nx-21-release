{
  "installation": {
    "version": "22.4.2"
  },
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "release": {
    "groups": {
      "commons": {
        "projects": ["commons/*"],
        "projectsRelationship": "fixed",
        "releaseTagPattern": "commons@{version}"
      },
      "apps-libs": {
        "projects": ["apps/*", "libs/*"],
        "projectsRelationship": "independent",
        "releaseTagPattern": "{projectName}@{version}"
      }
    },
    "version": {
      "conventionalCommits": true,
      "manifestRootsToUpdate": [
        "dist/{projectRoot}"
      ]
    },
    "git": {
      "commit": false,
      "stageChanges": false,
      "tag": false
    },
    "changelog": {
      "projectChangelogs": false
    }
  },
  "targetDefaults": {
    "build": {
      "command": "mkdir -p dist/{projectRoot} && cp {projectRoot}/package.json dist/{projectRoot}/package.json",
      "cwd": "{workspaceRoot}"
    },
    "nx-release-publish": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo publishing {projectName}"
      }
    }
  }
}
